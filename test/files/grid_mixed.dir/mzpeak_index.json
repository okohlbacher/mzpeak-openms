      "source": "analysis.tdf"
    },
    "vendor_tims_calibration": {
      "applies_to": "mean_inverse_reduced_ion_mobility of every point and the 1/K0 of every precursor/isolation band, unless --no-tims-recalibration (then timsrust's linear map of the nominal range)",
      "global_metadata": {
        "OneOverK0AcqRangeLower": 0.601567,
        "OneOverK0AcqRangeUpper": 1.601096
      },
      "model_type_2": "W = C2 + (C3 - C2)*(scan - C4 - C0)/C1; 1/K0 = W/(C7 + C6*W); scan 0-based (C5, C8, C9 do not enter; C0 = C5 = 1 on every file seen)",
      "model_type_2_verified": "6.7e-16 vs Bruker timsdata SDK tims_scannum_to_oneoverk0 on every scan of seven corpus runs, timsControl 4.0.5-6.2 (2026-09-15); the nominal OneOverK0AcqRange is not the model's value at the first/last scan",
      "source": "analysis.tdf",
      "tims_calibration": [
        {
          "C0": 1,
          "C1": 926,
          "C2": 217.23199652301727,
          "C3": 74.71319596975974,
          "C4": 33.0,
          "C5": 1,
          "C6": 0.020932469715718497,
          "C7": 131.22279563838268,
          "C8": 13.03725439289374,
          "C9": 2581.2848608831187,
          "Id": 1,
          "ModelType": 2
        }
      ]
    },
    "ims_calibration": {
      "chunk_bounds": "mz",
      "chunk_width_th": 50.0,
      "codec": "ims-compact",
      "encoding": "byte-stream-split on the index lists and the bounds",
      "exact": true,
      "intensity_dtype": "int32",
      "ion_mobility_grid": {
        "column": "chunk.mean_inverse_reduced_ion_mobility_grid",
        "evaluation": "mzdata::io::tdf::TimsCalibrationModel2::convert (reference implementation); differs from the closed form W/(C7 + C6*W) by at most 1 ulp",
        "indices": "TIMS scan number (uint32, 0-based, not delta-coded); 1/K0 = 1/(C6 + C7/(offset + slope*scan))",
        "model": "MS:9999001",
        "parameters": "[C6, C7, offset, slope] of TimsCalibration ModelType 2: slope = (C3 - C2)/C1, offset = C2 - slope*(C4 + C0)"
      },
      "layout": "grid-transform",
      "mz_grid": {
        "column": "chunk.mz_grid",
        "evaluation": "mzdata::io::tdf::MzCalibrationModel2::convert_f64 (reference implementation); the chunk bounds are that evaluation at the first and last bin",
        "indices": "[first TOF bin, deltas...] (uint32); t_ns = fma(bin, timebase, delay); solve t_ns = C0 + beta*u + C2*u^2 (+ C3*u^3) for u; m/z = u^2 - C4",
        "model": "MS:9999002",
        "parameters": "[C0, 1e6/sqrt(C1*cf), C2/cf, C3, C4, DigitizerTimebase, DigitizerDelay] of the frame's MzCalibration row, cf = 1 + (dC1*(T1 - Frames.T1) + dC2*(T2 - Frames.T2))/1e6",
        "verified": "1e-9 ppm vs Bruker timsdata SDK on a C2 != 0, C4 != 0 file (tests/fixtures/tdf_diapasef_sdk_golden.json)"
      },
      "previous_layout": {
        "note": "rewritten from the 0.12.x layout (integer TOF bounds, tof_chunk_values deltas, tof_c0/tof_c1 per spectrum); the tof_c0/tof_c1 spectra_metadata columns are kept as provenance and are no longer read",
        "tof_encoding": "m/z-chunked"
      },
